# Campaign data (user generated)
plan.xlsx
results.csv
*.log

# Image library — TEMPORARILY IGNORED (see "RE-ENABLE TRACKING" below).
#
# The bundled image library (~1,000 images) is excluded from git for
# now to keep pushes fast and the repo small. The images still live on
# disk at apps/desktop/src/resources/images/ and are still bundled by
# `npm run pack` via the extraResources entry in package.json — they
# simply are not tracked by git.
#
# *.png is ignored globally (see the screenshot rules below). The
# folder-level ignore below catches every format, not just PNG.
*.png
apps/desktop/src/resources/images/

# RE-ENABLE TRACKING LATER:
#   1. Delete the line above (`apps/desktop/src/resources/images/`).
#   2. Append these four negations, in this order, at the end of
#      this same section:
#          !apps/desktop/src/resources/images/**/*.png
#          !apps/desktop/src/resources/images/**/*.jpg
#          !apps/desktop/src/resources/images/**/*.jpeg
#          !apps/desktop/src/resources/images/**/*.webp
#   3. Run: git add apps/desktop/src/resources/images/

# Image optimization backups
# Written by apps/desktop/scripts/optimize-images.mjs — pre-optimization
# originals kept locally. Not tracked, not shipped in the .exe. Safe to
# delete if you no longer need the originals.
apps/desktop/.image-backups/

# Screenshots
results/*.png
error_*.png

# Temporary config
resources/config/*.tmp
resources/config/*.bak

# Playwright browsers (large, can be re-downloaded)
resources/python/lib/python*/site-packages/playwright/driver/
resources/python/lib/python*/site-packages/playwright/.local-browsers/

# Compiled Python (obfuscated)
resources/scripts/**/*.pyc
resources/scripts/**/__pycache__/

# Local environment
.env
.env.local
.env.*.local

