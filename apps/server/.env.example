# ============================================================
#  WriteSpeare — Backend Environment Variables (TEMPLATE)
# ============================================================
#  Copy this file to .env and fill in real values:
#
#      cp .env.example .env        (macOS / Linux)
#      copy .env.example .env      (Windows CMD)
#
#  .env is gitignored — real secrets must never be committed.
#  This template IS committed and must contain only placeholders.
# ============================================================


# ------------------------------------------------------------
#  Runtime
# ------------------------------------------------------------

# Node environment. One of: development | production | test.
#   development — verbose logging, CORS reflects origin, stack
#                 traces added to error responses.
#   production  — quiet logging, CORS disabled, no stack traces.
NODE_ENV=development

# HTTP listener port for the local dev server.
# Valid range: 1–65535. Falls back to 5000 if unset or invalid.
# Not used on Vercel (the platform assigns the port).
PORT=5000


# ------------------------------------------------------------
#  MongoDB
# ------------------------------------------------------------

# Connection URI for the WriteSpeare database.
#
# Local development (mongod running on the default port):
#   mongodb://localhost:27017/writespeare
#
# MongoDB Atlas (production / shared):
#   mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/writespeare?retryWrites=true&w=majority
#
# If unset, falls back to the localhost value above.
MONGODB_URI=mongodb://localhost:27017/writespeare


# ------------------------------------------------------------
#  JWT
# ------------------------------------------------------------

# Secret used to sign and verify authentication tokens.
#
# REQUIREMENTS:
#   - Must be at least 32 characters. The server REFUSES TO
#     START if the value is shorter — see
#     apps/server/src/features/auth/utils/jwt.ts.
#   - Must be kept secret. Anyone who knows it can forge tokens.
#   - Must be stable across restarts. Changing it invalidates
#     every issued token and forces every user to log in again.
#
# GENERATE A STRONG ONE:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# The value below is a placeholder. Replace it before running.
JWT_SECRET=CHANGE-ME-TO-A-LONG-RANDOM-STRING-AT-LEAST-32-CHARS


# ------------------------------------------------------------
#  Super-admin seed
# ------------------------------------------------------------

# Credentials used by `npm run seed` to create the initial
# admin user. Both values are read exactly once, by
# apps/server/src/features/shared/utils/seedAdmin.ts.
#
# After the first successful seed, these variables are inert —
# the seed is idempotent and will not touch an existing admin.
# They can be left in place or removed; removing them is fine
# because the seed is a one-time operation.

# Email of the super-admin account. Must be a valid email address.
ADMIN_EMAIL=admin@writespeare.com

# Password for the super-admin account. Must be at least 8
# characters — the seed refuses to create an admin with a
# shorter password. Change this before the FIRST seed run;
# changing it after has no effect on the already-created user
# (use the admin panel to change it there).
ADMIN_PASSWORD=replace-this-with-a-strong-password